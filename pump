<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#00ff88">
    <meta name="description" content="PUMP UP - Push-up Counter Game with MediaPipe Pose Detection">
    <title>PUMP UP - Push-up Counter</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #0a0e27;
            color: #f0f0f0;
            line-height: 1.6;
        }

        .app {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Home Screen */
        .screen {
            display: none;
            flex: 1;
            flex-direction: column;
        }

        .screen.active {
            display: flex;
        }

        .header {
            padding: 1.5rem 1rem;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 1px solid #333344;
        }

        .header h1 {
            font-size: 2rem;
            font-weight: 900;
            letter-spacing: -1px;
        }

        .header-subtitle {
            font-size: 0.875rem;
            color: #888888;
        }

        .rank-badge {
            background: #1a1f3a;
            border: 1px solid #333344;
            border-radius: 0.65rem;
            padding: 1rem;
            text-align: right;
        }

        .rank-badge-label {
            font-size: 0.75rem;
            color: #888888;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 0.25rem;
        }

        .rank-badge-value {
            font-size: 1.5rem;
            font-weight: 900;
            text-shadow: 0 0 10px currentColor;
            margin-bottom: 0.5rem;
        }

        .rank-badge-xp {
            font-size: 0.75rem;
            color: #888888;
        }

        .content {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 2rem 1rem;
        }

        .hero-text h2 {
            font-size: 3rem;
            font-weight: 900;
            margin-bottom: 1rem;
            line-height: 1.2;
        }

        .hero-text .crush {
            color: #00ff88;
            text-shadow: 0 0 10px #00ff88, 0 0 20px #00ff88;
        }

        .hero-text p {
            font-size: 1.125rem;
            color: #888888;
            max-width: 28rem;
            margin-bottom: 3rem;
        }

        .button-group {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            max-width: 28rem;
        }

        .button {
            background: #1a1f3a;
            border: 2px solid;
            border-radius: 0.65rem;
            padding: 1.5rem;
            text-align: left;
            cursor: pointer;
            transition: all 0.15s ease-out;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 1rem;
            color: #f0f0f0;
        }

        .button.active {
            border-color: #00ff88;
            box-shadow: 0 0 20px #00ff8844;
        }

        .button.active:hover {
            box-shadow: 0 0 30px #00ff88;
        }

        .button.active:active {
            transform: scale(0.95);
            box-shadow: 0 0 40px #00ff88;
        }

        .button.disabled {
            border-color: #333344;
            opacity: 0.5;
            cursor: not-allowed;
        }

        .button-label {
            font-size: 0.75rem;
            color: #888888;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 0.25rem;
        }

        .button-title {
            font-size: 1.5rem;
            font-weight: 900;
        }

        .button-icon {
            font-size: 1.5rem;
        }

        .coming-soon {
            background: #888888;
            color: #0a0e27;
            padding: 0.25rem 0.5rem;
            border-radius: 0.25rem;
            font-size: 0.75rem;
            font-weight: bold;
        }

        .footer {
            padding: 1.5rem 1rem;
            text-align: center;
            font-size: 0.75rem;
            color: #888888;
            border-top: 1px solid #333344;
        }

        /* Level Map Screen */
        .level-header {
            padding: 1.5rem 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #333344;
        }

        .back-btn {
            background: none;
            border: none;
            color: #f0f0f0;
            font-size: 1.5rem;
            cursor: pointer;
            transition: color 0.2s;
        }

        .back-btn:hover {
            color: #00ff88;
        }

        .level-header h1 {
            font-size: 1.5rem;
            font-weight: 900;
        }

        .levels-grid {
            flex: 1;
            overflow-y: auto;
            padding: 2rem 1rem;
            display: flex;
            justify-content: center;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
            max-width: 28rem;
        }

        .level-node {
            aspect-ratio: 1;
            border: 2px solid #333344;
            border-radius: 0.65rem;
            background: #1a1f3a;
            padding: 1rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease-out;
            position: relative;
            font-size: 0.875rem;
        }

        .level-node.open,
        .level-node.done {
            border-color: #00ff88;
            box-shadow: 0 0 20px #00ff8844;
        }

        .level-node.active {
            box-shadow: 0 0 30px #00ff88;
        }

        .level-node.locked {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .level-node:hover:not(.locked) {
            transform: scale(1.05);
        }

        .level-node:active:not(.locked) {
            transform: scale(0.95);
        }

        .level-number {
            font-size: 2rem;
            font-weight: 900;
            color: #f0f0f0;
        }

        .level-label {
            font-size: 0.75rem;
            color: #888888;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-top: 0.5rem;
        }

        .level-reps {
            font-size: 0.75rem;
            color: #888888;
            margin-top: 0.75rem;
        }

        .checkmark {
            position: absolute;
            top: 0.25rem;
            right: 0.25rem;
            color: #00ff88;
            font-size: 1rem;
        }

        .lock-icon {
            position: absolute;
            top: 0.25rem;
            right: 0.25rem;
            color: #888888;
            font-size: 1rem;
        }

        /* Level Play Screen */
        .play-header {
            background: #1a1f3a;
            border-bottom: 1px solid #333344;
            padding: 1rem;
        }

        .play-header-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.5rem;
        }

        .play-header-label {
            font-size: 0.75rem;
            color: #888888;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        .play-header-challenge {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .play-header-challenge-text {
            font-size: 1.125rem;
            font-weight: bold;
        }

        .play-header-progress {
            font-size: 0.875rem;
            color: #888888;
        }

        .camera-container {
            flex: 1;
            position: relative;
            background: #000;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }

        .camera-loading {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(0, 0, 0, 0.8);
            padding: 2rem;
            border-radius: 0.65rem;
            text-align: center;
            color: #f0f0f0;
        }

        .counter-section {
            background: #1a1f3a;
            border-top: 1px solid #333344;
            padding: 2rem 1rem;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }

        .counter {
            flex: 1;
        }

        .counter-label {
            font-size: 0.75rem;
            color: #888888;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 0.5rem;
        }

        .counter-value {
            font-size: 120px;
            font-weight: 900;
            line-height: 1;
            letter-spacing: -2px;
            color: #00ff88;
            text-shadow: 0 0 10px #00ff88, 0 0 20px #00ff88;
        }

        .timer {
            text-align: center;
        }

        .timer-value {
            font-size: 3rem;
            font-weight: 900;
            color: #f0f0f0;
        }

        .timer-value.warning {
            color: #ff006e;
            text-shadow: 0 0 10px #ff006e;
        }

        .modal {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.8);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            z-index: 50;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: #1a1f3a;
            border: 2px solid #333344;
            border-radius: 0.65rem;
            padding: 2rem;
            max-width: 28rem;
            width: 100%;
            text-align: center;
        }

        .modal-emoji {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .modal-title {
            font-size: 2rem;
            font-weight: 900;
            margin-bottom: 1rem;
        }

        .modal-title.win {
            color: #00ff88;
            text-shadow: 0 0 10px #00ff88;
        }

        .modal-title.lose {
            color: #ff006e;
            text-shadow: 0 0 10px #ff006e;
        }

        .modal-text {
            color: #888888;
            margin-bottom: 1.5rem;
        }

        .modal-buttons {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .modal-button {
            background: #00ff88;
            color: #0a0e27;
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 0.65rem;
            font-weight: bold;
            cursor: pointer;
            transition: opacity 0.2s;
        }

        .modal-button:hover {
            opacity: 0.9;
        }

        .modal-button.secondary {
            background: #1a1f3a;
            color: #f0f0f0;
            border: 1px solid #333344;
        }

        .modal-button.secondary:hover {
            border-color: #00ff88;
        }

        @media (max-width: 640px) {
            .hero-text h2 {
                font-size: 2rem;
            }

            .counter-value {
                font-size: 80px;
            }

            .grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 0.75rem;
            }
        }
    </style>
</head>
<body>
    <div class="app">
        <!-- HOME SCREEN -->
        <div id="homeScreen" class="screen active">
            <div class="header">
                <div>
                    <h1>PUMP UP</h1>
                    <p class="header-subtitle">Push-up Counter</p>
                </div>
                <div class="rank-badge">
                    <div class="rank-badge-label">Rank</div>
                    <div class="rank-badge-value" id="rankDisplay">Rookie</div>
                    <div class="rank-badge-xp" id="xpDisplay">0 XP</div>
                </div>
            </div>

            <div class="content">
                <div class="hero-text">
                    <h2>Ready to <span class="crush">CRUSH</span>?</h2>
                    <p>Test your strength, level up your skills, and become an elite fitness warrior.</p>
                </div>

                <div class="button-group">
                    <button class="button active" onclick="goToLevels()">
                        <div>
                            <div class="button-label">Mode</div>
                            <div class="button-title">LEVELS</div>
                        </div>
                        <div class="button-icon">🎮</div>
                    </button>
                    <button class="button disabled">
                        <div>
                            <div class="button-label">Mode</div>
                            <div class="button-title">NORMAL</div>
                        </div>
                        <div class="coming-soon">Coming Soon</div>
                    </button>
                    <button class="button disabled">
                        <div>
                            <div class="button-label">Mode</div>
                            <div class="button-title">ONLINE</div>
                        </div>
                        <div class="coming-soon">Coming Soon</div>
                    </button>
                </div>
            </div>

            <div class="footer">
                <p id="progressText">0 / 10 levels completed • Keep pushing!</p>
            </div>
        </div>

        <!-- LEVEL MAP SCREEN -->
        <div id="levelMapScreen" class="screen">
            <div class="level-header">
                <button class="back-btn" onclick="goToHome()">←</button>
                <h1>LEVEL MAP</h1>
                <div style="width: 2rem;"></div>
            </div>

            <div class="levels-grid">
                <div class="grid" id="levelsGrid"></div>
            </div>

            <div class="footer">
                <p id="levelProgressText">0 / 10 levels completed</p>
            </div>
        </div>

        <!-- LEVEL PLAY SCREEN -->
        <div id="levelPlayScreen" class="screen">
            <div class="play-header">
                <div class="play-header-top">
                    <div class="play-header-label" id="levelLabel">Level 1</div>
                    <button class="back-btn" onclick="goToLevels()">✕</button>
                </div>
                <div class="play-header-challenge">
                    <div class="play-header-challenge-text" id="challengeText">5 push-ups in 60s</div>
                    <div class="play-header-progress" id="progressDisplay">0 / 5</div>
                </div>
            </div>

            <div class="camera-container">
                <video id="video" autoplay playsinline></video>
                <canvas id="canvas" width="640" height="480"></canvas>
                <div class="camera-loading" id="cameraLoading" style="display: none;">
                    <div>Initializing camera...</div>
                </div>
            </div>

            <div class="counter-section">
                <div class="counter">
                    <div class="counter-label">Reps</div>
                    <div class="counter-value" id="repCounter">0</div>
                </div>
                <div class="timer">
                    <div class="counter-label">Time</div>
                    <div class="timer-value" id="timerDisplay">60s</div>
                </div>
            </div>

            <div class="modal" id="resultModal">
                <div class="modal-content">
                    <div class="modal-emoji" id="resultEmoji">🎉</div>
                    <div class="modal-title" id="resultTitle">LEVEL UP!</div>
                    <div class="modal-text" id="resultText">Great job! You earned 10 XP.</div>
                    <div class="modal-buttons" id="resultButtons"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Game State
        const LEVELS = [
            { id: 1, target: 5, timeLimit: 60, xpReward: 10 },
            { id: 2, target: 8, timeLimit: 60, xpReward: 15 },
            { id: 3, target: 10, timeLimit: 60, xpReward: 20 },
            { id: 4, target: 12, timeLimit: 60, xpReward: 25 },
            { id: 5, target: 15, timeLimit: 60, xpReward: 30 },
            { id: 6, target: 18, timeLimit: 60, xpReward: 35 },
            { id: 7, target: 20, timeLimit: 60, xpReward: 40 },
            { id: 8, target: 25, timeLimit: 60, xpReward: 50 },
            { id: 9, target: 30, timeLimit: 60, xpReward: 60 },
            { id: "boss", target: 25, timeLimit: 90, xpReward: 100 },
        ];

        const RANK_TIERS = [
            { minXP: 0, maxXP: 49, rank: "Rookie", color: "#888888" },
            { minXP: 50, maxXP: 149, rank: "Grinder", color: "#00d4ff" },
            { minXP: 150, maxXP: 299, rank: "Beast", color: "#ff006e" },
            { minXP: 300, maxXP: Infinity, rank: "Elite", color: "#00ff88" },
        ];

        let gameState = {
            totalXP: 0,
            rank: "Rookie",
            levelsCompleted: [],
            currentUnlockedLevel: 1,
        };

        let currentLevel = null;
        let repCount = 0;
        let timeLeft = 0;
        let gameStatus = "idle";
        let timerInterval = null;
        let poseDetector = null;
        let repState = "UP";
        let lastRepTime = 0;

        // Load game state from localStorage
        function loadGameState() {
            const stored = localStorage.getItem("pump_up_state");
            if (stored) {
                gameState = JSON.parse(stored);
            }
            updateUI();
        }

        // Save game state
        function saveGameState() {
            localStorage.setItem("pump_up_state", JSON.stringify(gameState));
        }

        // Get rank for XP
        function getRankForXP(xp) {
            const tier = RANK_TIERS.find(t => xp >= t.minXP && xp <= t.maxXP);
            return tier || RANK_TIERS[RANK_TIERS.length - 1];
        }

        // Update UI
        function updateUI() {
            const rank = getRankForXP(gameState.totalXP);
            document.getElementById("rankDisplay").textContent = rank.rank;
            document.getElementById("rankDisplay").style.color = rank.color;
            document.getElementById("xpDisplay").textContent = gameState.totalXP + " XP";
            document.getElementById("progressText").textContent = gameState.levelsCompleted.length + " / 10 levels completed • Keep pushing!";
            document.getElementById("levelProgressText").textContent = gameState.levelsCompleted.length + " / 10 levels completed";
            renderLevels();
        }

        // Render level grid
        function renderLevels() {
            const grid = document.getElementById("levelsGrid");
            grid.innerHTML = "";

            LEVELS.forEach(level => {
                const isCompleted = gameState.levelsCompleted.includes(level.id);
                const isOpen = gameState.currentUnlockedLevel >= level.id;
                const isLocked = !isOpen;

                const node = document.createElement("button");
                node.className = "level-node";
                if (isCompleted) node.classList.add("done");
                if (isOpen && !isCompleted) node.classList.add("open");
                if (isLocked) node.classList.add("locked");

                const icon = level.id === "boss" ? "🏆" : level.id;
                const label = level.id === "boss" ? "Boss" : "Level";

                node.innerHTML = `
                    <div class="level-number">${icon}</div>
                    <div class="level-label">${label}</div>
                    <div class="level-reps">${level.target} reps</div>
                    ${isCompleted ? '<div class="checkmark">✓</div>' : ''}
                    ${isLocked ? '<div class="lock-icon">🔒</div>' : ''}
                `;

                node.onclick = () => {
                    if (!isLocked) startLevel(level.id);
                };

                grid.appendChild(node);
            });
        }

        // Navigation
        function showScreen(screenId) {
            document.querySelectorAll(".screen").forEach(s => s.classList.remove("active"));
            document.getElementById(screenId).classList.add("active");
        }

        function goToHome() {
            stopLevel();
            showScreen("homeScreen");
        }

        function goToLevels() {
            stopLevel();
            showScreen("levelMapScreen");
            updateUI();
        }

        // Start level
        function startLevel(levelId) {
            currentLevel = LEVELS.find(l => l.id === levelId);
            if (!currentLevel) return;

            repCount = 0;
            timeLeft = currentLevel.timeLimit;
            gameStatus = "playing";

            document.getElementById("levelLabel").textContent = levelId === "boss" ? "Boss Challenge" : `Level ${levelId}`;
            document.getElementById("challengeText").textContent = `${currentLevel.target} push-ups in ${currentLevel.timeLimit}s`;
            document.getElementById("repCounter").textContent = "0";
            document.getElementById("timerDisplay").textContent = timeLeft + "s";
            document.getElementById("progressDisplay").textContent = `0 / ${currentLevel.target}`;

            showScreen("levelPlayScreen");
            initCamera();
            startTimer();
        }

        // Stop level
        function stopLevel() {
            gameStatus = "idle";
            if (timerInterval) clearInterval(timerInterval);
            if (navigator.mediaDevices) {
                const video = document.getElementById("video");
                if (video.srcObject) {
                    video.srcObject.getTracks().forEach(track => track.stop());
                }
            }
        }

        // Init camera
        async function initCamera() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: "user", width: { ideal: 640 }, height: { ideal: 480 } }
                });
                const video = document.getElementById("video");
                video.srcObject = stream;
                video.onloadedmetadata = () => {
                    document.getElementById("cameraLoading").style.display = "none";
                    initPoseDetection();
                };
            } catch (err) {
                alert("Camera access denied. Please allow camera permission.");
                goToLevels();
            }
        }

        // Init MediaPipe Pose
        function initPoseDetection() {
            const script = document.createElement("script");
            script.src = "https://cdn.jsdelivr.net/npm/@mediapipe/pose@0.5.1635989137/pose.min.js";
            document.head.appendChild(script);

            script.onload = () => {
                const Pose = window.Pose;
                if (!Pose) return;

                poseDetector = new Pose({
                    locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/pose@0.5.1635989137/${file}`,
                });

                poseDetector.setOptions({
                    modelComplexity: 1,
                    smoothLandmarks: true,
                    minDetectionConfidence: 0.5,
                    minTrackingConfidence: 0.5,
                });

                poseDetector.onResults(handlePoseResults);

                const detectPose = async () => {
                    if (gameStatus === "playing" && document.getElementById("video").srcObject) {
                        await poseDetector.send({ image: document.getElementById("video") });
                        requestAnimationFrame(detectPose);
                    }
                };

                detectPose();
            };
        }

        // Handle pose results
        function handlePoseResults(results) {
            if (!results.poseLandmarks || results.poseLandmarks.length === 0) return;

            const landmarks = results.poseLandmarks;
            const leftShoulder = landmarks[11];
            const leftElbow = landmarks[13];
            const leftWrist = landmarks[15];
            const rightShoulder = landmarks[12];
            const rightElbow = landmarks[14];
            const rightWrist = landmarks[16];

            const leftAngle = calculateAngle(leftShoulder, leftElbow, leftWrist);
            const rightAngle = calculateAngle(rightShoulder, rightElbow, rightWrist);
            const avgAngle = (leftAngle + rightAngle) / 2;

            updateRepCount(avgAngle);
            drawPoseOverlay(landmarks);
        }

        // Calculate angle
        function calculateAngle(a, b, c) {
            const radians = Math.atan2(c.y - b.y, c.x - b.x) - Math.atan2(a.y - b.y, a.x - b.x);
            let angle = Math.abs((radians * 180) / Math.PI);
            if (angle > 180) angle = 360 - angle;
            return angle;
        }

        // Update rep count
        function updateRepCount(angle) {
            const now = Date.now();
            const debounceTime = 300;

            if (angle < 90 && repState === "UP") {
                repState = "DOWN";
            } else if (angle > 160 && repState === "DOWN") {
                if (now - lastRepTime > debounceTime) {
                    repCount++;
                    lastRepTime = now;
                    if ("vibrate" in navigator) navigator.vibrate(50);
                    
                    document.getElementById("repCounter").textContent = repCount;
                    document.getElementById("progressDisplay").textContent = `${repCount} / ${currentLevel.target}`;

                    if (repCount >= currentLevel.target) {
                        completeLevel();
                    }
                }
                repState = "UP";
            }
        }

        // Draw pose overlay
        function drawPoseOverlay(landmarks) {
            const canvas = document.getElementById("canvas");
            const ctx = canvas.getContext("2d");
            const width = canvas.width;
            const height = canvas.height;

            ctx.clearRect(0, 0, width, height);

            const connections = [[11, 13], [13, 15], [12, 14], [14, 16], [11, 12], [11, 23], [12, 24]];

            ctx.strokeStyle = "#00ff88";
            ctx.lineWidth = 2;

            connections.forEach(([start, end]) => {
                const p1 = landmarks[start];
                const p2 = landmarks[end];
                if (p1.visibility > 0.5 && p2.visibility > 0.5) {
                    ctx.beginPath();
                    ctx.moveTo(p1.x * width, p1.y * height);
                    ctx.lineTo(p2.x * width, p2.y * height);
                    ctx.stroke();
                }
            });

            ctx.fillStyle = "#00ff88";
            landmarks.forEach(landmark => {
                if (landmark.visibility > 0.5) {
                    ctx.beginPath();
                    ctx.arc(landmark.x * width, landmark.y * height, 4, 0, 2 * Math.PI);
                    ctx.fill();
                }
            });
        }

        // Start timer
        function startTimer() {
            timerInterval = setInterval(() => {
                timeLeft--;
                document.getElementById("timerDisplay").textContent = timeLeft + "s";

                if (timeLeft <= 10) {
                    document.getElementById("timerDisplay").classList.add("warning");
                }

                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    if (repCount >= currentLevel.target) {
                        completeLevel();
                    } else {
                        failLevel();
                    }
                }
            }, 1000);
        }

        // Complete level
        function completeLevel() {
            gameStatus = "won";
            clearInterval(timerInterval);

            const isFirstClear = !gameState.levelsCompleted.includes(currentLevel.id);
            if (isFirstClear) {
                gameState.totalXP += currentLevel.xpReward;
                gameState.levelsCompleted.push(currentLevel.id);
                gameState.rank = getRankForXP(gameState.totalXP).rank;

                const nextLevelIndex = LEVELS.findIndex(l => l.id === currentLevel.id) + 1;
                if (nextLevelIndex < LEVELS.length) {
                    gameState.currentUnlockedLevel = Math.max(gameState.currentUnlockedLevel, nextLevelIndex + 1);
                }

                saveGameState();
            }

            document.getElementById("resultEmoji").textContent = "🎉";
            document.getElementById("resultTitle").textContent = "LEVEL UP!";
            document.getElementById("resultTitle").className = "modal-title win";
            document.getElementById("resultText").textContent = `Great job! You earned ${currentLevel.xpReward} XP.`;
            document.getElementById("resultButtons").innerHTML = `
                <button class="modal-button" onclick="goToLevels()">Continue</button>
            `;
            document.getElementById("resultModal").classList.add("active");
        }

        // Fail level
        function failLevel() {
            gameStatus = "lost";
            clearInterval(timerInterval);

            document.getElementById("resultEmoji").textContent = "💪";
            document.getElementById("resultTitle").textContent = "TIME'S UP!";
            document.getElementById("resultTitle").className = "modal-title lose";
            document.getElementById("resultText").textContent = `You got ${repCount} / ${currentLevel.target} reps. Try again!`;
            document.getElementById("resultButtons").innerHTML = `
                <button class="modal-button" onclick="retryLevel()">Retry</button>
                <button class="modal-button secondary" onclick="goToLevels()">Back to Map</button>
            `;
            document.getElementById("resultModal").classList.add("active");
        }

        // Retry level
        function retryLevel() {
            document.getElementById("resultModal").classList.remove("active");
            document.getElementById("timerDisplay").classList.remove("warning");
            startLevel(currentLevel.id);
        }

        // Initialize
        loadGameState();
    </script>
</body>
</html>
